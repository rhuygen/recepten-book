{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "recepten-book",
      "runtimeExecutable": ".venv/bin/mkdocs",
      "runtimeArgs": ["serve", "--dev-addr", "127.0.0.1:8765"],
      "port": 8765
